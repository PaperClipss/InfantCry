{
  "name": "infantcry-mobile",
  "version": "0.1.0",
  "private": true,
  "description": "InfantCry mobile frontend built with HTML, CSS, JavaScript and Capacitor.",
  "scripts": {
    "start": "node scripts/dev-server.mjs",
    "test": "node --test tests/*.test.cjs",
    "cap:sync": "cap sync",
    "android:add": "cap add android",
    "android:permissions": "node scripts/ensure-android-permissions.mjs",
    "android:open": "cap open android",
    "android:run": "npm run android:permissions && cap sync android && cap open android",
    "ios:add": "cap add ios",
    "ios:permissions": "node scripts/ensure-ios-permissions.mjs",
    "ios:open": "cap open ios"
  },
  "dependencies": {
    "@capacitor/android": "^8.0.0",
    "@capacitor/core": "^8.0.0",
    "@capacitor/ios": "^8.0.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.0.0"
  }
}
